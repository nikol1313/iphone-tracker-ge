{
  "info": {
    "name": "iPhone Tracker API — 42 tests",
    "description": "Run the folders in order: later tests use values saved by earlier ones.\nEvery run makes its own fresh user in #01, so nothing needs setting up first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "01 Register a new user → 201, no password in reply",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Start of a run: forget what an earlier run saved.",
                  "[\"token\", \"user2Token\", \"alertId\"].forEach((name) => pm.collectionVariables.unset(name));",
                  "",
                  "// A new email every run. example.com is reserved for tests, so no real inbox ever gets mail.",
                  "const name = pm.variables.replaceIn(\"{{$randomUserName}}\").replace(/[^a-z0-9]/gi, \"\");",
                  "pm.collectionVariables.set(\"email\", `${name}.${Date.now()}@example.com`.toLowerCase());",
                  "pm.collectionVariables.set(\"password\", \"Passw0rd-123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const user = pm.response.json();",
                  "",
                  "pm.test(\"Reply shows the email we registered\", () => {",
                  "    pm.expect(user.email).to.equal(pm.collectionVariables.get(\"email\"));",
                  "});",
                  "",
                  "pm.test(\"Reply never contains the password\", () => {",
                  "    pm.expect(user).to.not.have.property(\"password\");",
                  "    pm.expect(user).to.not.have.property(\"password_hash\");",
                  "    pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get(\"password\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "02 Register the same email again → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict (not 500)\", () => {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Error message explains the problem\", () => {",
                  "    pm.expect(pm.response.json().detail).to.be.a(\"string\").and.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "03 Register with a bad email → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422 Unprocessable\", () => {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error points at the email field\", () => {",
                  "    const error = pm.response.json().detail[0];",
                  "    pm.expect(error.loc).to.include(\"email\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"Passw0rd-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "04 Register without a password → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422 Unprocessable\", () => {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error points at the password field\", () => {",
                  "    const error = pm.response.json().detail[0];",
                  "    pm.expect(error.loc).to.include(\"password\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nopassword@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "05 Login with the right password → 200 + token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const reply = pm.response.json();",
                  "",
                  "pm.test(\"Reply has a bearer token\", () => {",
                  "    pm.expect(reply.access_token).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.expect(reply.token_type).to.equal(\"bearer\");",
                  "});",
                  "",
                  "// Every request that inherits the collection's auth now sends this token.",
                  "pm.collectionVariables.set(\"token\", reply.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "This API's login takes JSON (`email`, `password`), not form-data."
          }
        },
        {
          "name": "06 Login with a wrong password → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"No token is given out\", () => {",
                  "    pm.expect(pm.response.json()).to.not.have.property(\"access_token\");",
                  "});",
                  "",
                  "// Test 07 checks that an unknown email gets this exact same message.",
                  "pm.collectionVariables.set(\"loginErrorMessage\", pm.response.json().detail);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong-password-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "07 Login with an unknown email → same 401 as #06 🔐",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Same error message as a wrong password (#06)\", () => {",
                  "    pm.expect(pm.response.json().detail).to.equal(pm.collectionVariables.get(\"loginErrorMessage\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody.{{$timestamp}}@example.com\",\n  \"password\": \"Passw0rd-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "User enumeration check: if 'wrong password' and 'no such user' gave different answers,\nan attacker could find out which emails have accounts."
          }
        },
        {
          "name": "08 Password reset for my email → 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// Test 09 compares its answer with these.",
                  "pm.collectionVariables.set(\"resetStatus\", String(status));",
                  "pm.collectionVariables.set(\"resetBody\", pm.response.text());",
                  "",
                  "if (status === 503) {",
                  "    pm.test.skip(\"Reset request accepted (skipped: server has no SMTP settings)\", () => {});",
                  "} else {",
                  "    pm.test(\"Status is 200, 202 or 204\", () => {",
                  "        pm.expect(status).to.be.oneOf([200, 202, 204]);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "The API answers 204 No Content. A server without SMTP settings answers 503 instead;\nthen this test is skipped, but #09 still checks both answers match."
          }
        },
        {
          "name": "09 Password reset for an unknown email → same as #08 🔐",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Same status as for a real account (#08)\", () => {",
                  "    pm.expect(String(pm.response.code)).to.equal(pm.collectionVariables.get(\"resetStatus\"));",
                  "});",
                  "",
                  "pm.test(\"Same body as for a real account (#08)\", () => {",
                  "    pm.expect(pm.response.text()).to.equal(pm.collectionVariables.get(\"resetBody\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody.{{$timestamp}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "10 Confirm reset with a fake token → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message explains the problem\", () => {",
                  "    pm.expect(pm.response.json().detail).to.be.a(\"string\").and.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"this-is-not-a-real-token\",\n  \"password\": \"New-Passw0rd-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "11 List products → 200, valid page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const page = pm.response.json();",
                  "",
                  "pm.test(\"Reply is a page: items, total, limit, offset\", () => {",
                  "    pm.expect(page).to.have.keys(\"items\", \"total\", \"limit\", \"offset\");",
                  "    pm.expect(page.items).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(page.total).to.be.at.least(page.items.length);",
                  "});",
                  "",
                  "pm.test(\"Every product has an id, brand and model\", () => {",
                  "    page.items.forEach((product) => {",
                  "        pm.expect(product.id).to.be.a(\"number\");",
                  "        pm.expect(product.brand).to.be.a(\"string\").and.not.be.empty;",
                  "        pm.expect(product.model).to.be.a(\"string\").and.not.be.empty;",
                  "    });",
                  "});",
                  "",
                  "// Folders 4-6 need a real phone that stores already sell, so it has prices.",
                  "const withPrices = page.items.find((product) => product.lowest_price !== null);",
                  "",
                  "pm.test(\"At least one product has scraped prices\", () => {",
                  "    pm.expect(withPrices).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"existingProductId\", (withPrices || page.items[0]).id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "12 Create a product without logging in → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Apple\",\n  \"model\": \"Should Not Exist\",\n  \"storage\": \"128GB\",\n  \"color\": \"Black\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "13 Get a product that does not exist → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "999999"
              ]
            }
          }
        },
        {
          "name": "14 Get a product with a text id → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422 Unprocessable\", () => {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error points at the product id\", () => {",
                  "    const error = pm.response.json().detail[0];",
                  "    pm.expect(error.loc).to.include(\"product_id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "abc"
              ]
            }
          }
        },
        {
          "name": "15 Get specs of a real phone → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const specs = pm.response.json();",
                  "",
                  "pm.test(\"Reply has product_id, model and a specs object\", () => {",
                  "    pm.expect(specs).to.include.keys(\"product_id\", \"model\", \"specs\");",
                  "    pm.expect(specs.specs).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"Specs are for the phone we asked about\", () => {",
                  "    pm.expect(specs.product_id).to.equal(Number(pm.collectionVariables.get(\"existingProductId\")));",
                  "});",
                  "",
                  "pm.test(\"Every spec value is text\", () => {",
                  "    Object.values(specs.specs).forEach((value) => pm.expect(value).to.be.a(\"string\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{existingProductId}}/specs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{existingProductId}}",
                "specs"
              ]
            }
          }
        }
      ]
    }
  ]
}
