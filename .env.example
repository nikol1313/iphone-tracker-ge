# Copy to .env and fill in. Never commit .env.

# Postgres (used by docker compose for the db container and the backend URL)
POSTGRES_DB=iphone_monitor
POSTGRES_USER=iphone_monitor
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Only used when running the backend outside docker compose
DATABASE_URL=postgresql+asyncpg://iphone_monitor:password@localhost:5432/iphone_monitor

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# Set true on a deployed server: refuses to start without DATABASE_URL and a real JWT_SECRET
PROD=false

# Refresh prices from all retailers every 12 hours (set false to disable)
REFRESH_SCHEDULER_ENABLED=true

# Outgoing email for price alerts (optional; alerts wait until set).
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Price Monitor <you@gmail.com>

# Host port nginx listens on
HTTP_PORT=8080
